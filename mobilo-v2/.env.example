# Mobilo environment variables.
#
# Copy this file to `.env` and fill in real values. Anything prefixed with
# EXPO_PUBLIC_ gets baked into the JS bundle at build time, so don't put
# server-side secrets in here. The Supabase anon key is safe to ship; it
# only grants access according to your Row Level Security policies.

# Supabase project credentials (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: live route sync backend. Leave blank to use bundled routes.
# EXPO_PUBLIC_API_BASE_URL=

# Razorpay public key id (Dashboard -> Settings -> API Keys). Safe to ship;
# the key SECRET stays server-side in the `payments` Edge Function. Leave
# blank to fall back to recorded/offline payments in development.
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
